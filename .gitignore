__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/

# DO NOT ignore trace files or the eval database.
# These are the project's primary evidence/results, not build artifacts.
# A reviewer cloning this repo should see the actual run data.
# *.jsonl   <- intentionally NOT ignored
# *.sqlite  <- intentionally NOT ignored

# ...with two exceptions, which really are artifacts:
#   - the universal arena's example projects regenerate their results on every
#     demo run (a representative report is committed at docs/EXAMPLE_REPORT.md)
#   - eval_db.sqlite is a fixture database run_baseline.py recreates per run
projects/*/results/
eval_db.sqlite

# The study's sweep output. Its scripts write to `results/` relative to the
# working directory, so ignore the fixture DB under both the study root (the
# documented place to run from) and the repo root.
results/eval_db.sqlite
studies/multi_agent_handoff/results/eval_db.sqlite

# pytest
.pytest_cache/
.coverage

# Secrets — never commit these
.env
.env.local
*.key

# OS / editor noise
.DS_Store
.vscode/
*.swp

# Python packaging
*.egg-info/
dist/
build/

# Generated documentation site (built by site/build.py, deployed by CI).
site/_build/
